# Copy to .env for local runs. Never commit real values.
# Only ANTHROPIC_API_KEY is used by this package itself (core/llm.py); everything
# else below is agent-specific and listed here as a reference for agent repos.

ANTHROPIC_API_KEY=
# Fallback read when ANTHROPIC_API_KEY is unset (some cloud dev environments reserve
# that name for their own use). Only needed if ANTHROPIC_API_KEY isn't set.
# AGENTS_ANTHROPIC_API_KEY=

# Common per-agent source keys (not read by agents-core itself):
# FRED_API_KEY=
# BLS_API_KEY=
# SAM_API_KEY=
# CENSUS_API_KEY=
# GITHUB_TOKEN=

# agents_core.settings overrides — all optional, shown here at their defaults:
# AGENTS_CORE_DATA_DIR=data
# AGENTS_CORE_PUBLISH_DIR=public-data
# AGENTS_CORE_MAX_RUN_USD=0.50
# AGENTS_CORE_COSTS_PATH=data/costs.jsonl
# AGENTS_CORE_GUARD_FAILURES_PATH=data/guard_failures.jsonl
# AGENTS_CORE_HTTP_CACHE_DIR=.cache/http
# AGENTS_CORE_HTTP_CACHE_TTL_SECONDS=21600
