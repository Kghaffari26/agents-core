# Copy to .env for local runs. Never commit real values.
ANTHROPIC_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
SAM_API_KEY=
CENSUS_API_KEY=
GITHUB_TOKEN=
# Fine-grained PAT used only by repo_maint --apply for writes to other repos.
REPO_MAINT_TOKEN=

# Per-run LLM spend cap in USD (default 0.50).
MAX_RUN_USD=0.50
# Optional overrides
# PUBLISH_DIR=site/public/data
# COSTS_PATH=data/costs.jsonl
# HTTP_CACHE_DIR=.cache/http
# HTTP_CACHE_TTL_SECONDS=21600
